{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cargo build",
			"type": "shell",
			"command": "cargo",
			"args": ["build"],
			"group": { "kind": "build", "isDefault": false },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "silent" }
		},
		{
			"label": "cargo build --release",
			"type": "shell",
			"command": "cargo",
			"args": ["build", "--release"],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "silent" }
		},
		{
			"label": "cargo run --release",
			"type": "shell",
			"command": "cargo",
			"args": ["run", "--release"],
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always" }
		},
		{
			"label": "cargo run",
			"type": "shell",
			"command": "cargo",
			"args": ["run"],
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always" }
		}
	]
}