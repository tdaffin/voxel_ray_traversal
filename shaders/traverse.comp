#version 460
#extension GL_EXT_nonuniform_qualifier : require

#ifndef DEBUG_WEDGE
#define DEBUG_WEDGE 1
#endif

// Render modes: MUST stay in sync with the Rust RenderMode enum (search for RenderMode in main.rs or related file)
const uint COORD = 0;
const uint STEPS = 1;
const uint NORMAL = 2;
const uint UV = 3;
const uint DEPTH = 4;
const uint SHADE = 5; // New: shaded lighting + simple AO (update host RenderMode enum accordingly)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    mat4 pixelToRay;
    vec4 lightDir; // xyz = normalized light direction, w unused
    uint voxel_count;
    uint render_mode;
} pc;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D targetImage;
// Runtime-sized array of voxel grids (descriptor array only)
// Fixed-size descriptor array to simplify host binding (avoid runtime descriptor array issues)
const int MAX_GRIDS = 32;
layout(set = 1, binding = 0, rgba32ui) readonly uniform uimage3D voxelImages[MAX_GRIDS];
// Per-voxel palette index (R8_UINT) stored in R component of each texel.
// Future enhancement: add a small palette buffer (e.g. SSBO of vec4) so index -> color lookup supports custom materials.
layout(set = 1, binding = 1, r8ui) readonly uniform uimage3D voxelColorIndices[MAX_GRIDS];
// Palette buffer: 256 RGBA colors (can be fewer; unused entries ignored)
layout(set = 1, binding = 2) readonly buffer PaletteBuffer {
    vec4 palette[]; // size announced by host; expected <= 256
};
// Per-grid metadata buffer (dynamic length = voxel_count)
struct GridInfo {
    uint resolution; // legacy (kept for backward compatibility; not used for addressing now)
    uint dimX;       // actual content dims (<= resolution)
    uint dimY;
    uint dimZ;
    uint storageW;   // packed texel width (currently resolution/4)
    uint storageH;   // packed texel height (currently resolution/4)
    uint storageD;   // packed texel depth (currently resolution/8)
    uint paletteBase; // starting index into palette buffer
    uint paletteLen;  // number of valid entries for this grid
    uint _padding0;   // pad to 16-byte alignment for subsequent matrix
    uint _padding1;
    uint _padding2;
    mat4 gridToWorld; // transforms voxel-local coordinates to world space
};
layout(set = 1, binding = 3) readonly buffer GridInfoBuffer { GridInfo gridInfos[]; };

// https://www.shadertoy.com/view/WlfXRN
vec3 inferno(float t) {
    const vec3 c0 = vec3(0.0002189403691192265, 0.001651004631001012, -0.01948089843709184);
    const vec3 c1 = vec3(0.1065134194856116, 0.5639564367884091, 3.932712388889277);
    const vec3 c2 = vec3(11.60249308247187, -3.972853965665698, -15.9423941062914);
    const vec3 c3 = vec3(-41.70399613139459, 17.43639888205313, 44.35414519872813);
    const vec3 c4 = vec3(77.162935699427, -33.40235894210092, -81.80730925738993);
    const vec3 c5 = vec3(-71.31942824499214, 32.62606426397723, 73.20951985803202);
    const vec3 c6 = vec3(25.13112622477341, -12.24266895238567, -23.07032500287172);

    return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
}

vec3 stepsToInferno(uint steps, uint start, uint end) {
    float t = float(int(steps - start)) / (end - start);
    return inferno(clamp(t, 0, 1));
}

bool readVoxel(ivec3 coord, inout uvec4 texel, inout ivec3 texel_coord, int gridIndex, ivec3 dims) {
    if (coord.x < 0 || coord.y < 0 || coord.z < 0 || coord.x >= dims.x || coord.y >= dims.y || coord.z >= dims.z)
        return false;
    ivec3 new_texel_coord = ivec3(coord.x >> 2, coord.y >> 2, coord.z >> 3);
    if (new_texel_coord != texel_coord) {
        texel_coord = new_texel_coord;
        texel = imageLoad(voxelImages[gridIndex], texel_coord);
    }
    uint bitIndex = uint((coord.y & 3) + ((coord.z & 7) << 2));
    uint mask = 1u << bitIndex;
    return (texel[coord.x & 3] & mask) != 0u;
}

const float FLT_MAX = 3.4028235e+38;

bool traversal(
    int gridIndex,
    vec3 origin,
    vec3 dir,
    uvec3 dims,
    out vec3 color,
    out uint steps,
    out float hitParam
) {
    const float VOXEL_EPS = 1e-3;
    const float DIR_EPS = 1e-6;
    ivec3 dimsI = ivec3(dims);

    vec3 bounds_min = vec3(0.0);
    vec3 bounds_max = vec3(dims);

    float tmin = 0.0;
    float tmax = FLT_MAX;
    vec3 inv_dir = vec3(0.0);
    vec3 sgn_dir = vec3(0.0);
    int entryAxis = 0;
    float entryAxisValue = -FLT_MAX;

    for (int axis = 0; axis < 3; ++axis) {
        float d = dir[axis];
        if (abs(d) < DIR_EPS) {
            if (origin[axis] < bounds_min[axis] || origin[axis] > bounds_max[axis]) {
                steps = 0;
                hitParam = FLT_MAX;
                return false;
            }
            inv_dir[axis] = 0.0;
            sgn_dir[axis] = 0.0;
            continue;
        }

    float inv = 1.0 / d;
    inv_dir[axis] = inv;
    sgn_dir[axis] = (d > 0.0) ? 1.0 : -1.0;

    float expandMin = (d > 0.0) ? -VOXEL_EPS : VOXEL_EPS;
    float expandMax = (d > 0.0) ? VOXEL_EPS : -VOXEL_EPS;

    float t1 = ((bounds_min[axis] + expandMin) - origin[axis]) * inv;
    float t2 = ((bounds_max[axis] + expandMax) - origin[axis]) * inv;
        float axisMin = min(t1, t2);
        float axisMax = max(t1, t2);

        if (axisMin > entryAxisValue) {
            entryAxisValue = axisMin;
            entryAxis = axis;
        }

        tmin = max(tmin, axisMin);
        tmax = min(tmax, axisMax);
        if (tmin > tmax) {
            steps = 0;
            hitParam = FLT_MAX;
            return false;
        }
    }

    vec3 entryPoint = origin + dir * tmin;
    entryPoint = clamp(entryPoint, vec3(0.0) + VOXEL_EPS, vec3(dims) - vec3(VOXEL_EPS));
    origin = entryPoint;

    vec3 travelOrigin = entryPoint + sgn_dir * VOXEL_EPS;
    travelOrigin = clamp(travelOrigin, vec3(0.0) + VOXEL_EPS, vec3(dims) - vec3(VOXEL_EPS));
    ivec3 coord = ivec3(clamp(floor(travelOrigin), vec3(0.0), vec3(vec3(dims) - 1.0)));

    vec3 cellOffset = travelOrigin - vec3(coord);
    vec3 absInvDir = abs(inv_dir);
    vec3 tMax;
    vec3 tDelta;
    for (int axis = 0; axis < 3; ++axis) {
        if (sgn_dir[axis] > 0.0) {
            tMax[axis] = (1.0 - cellOffset[axis]) * absInvDir[axis];
            tDelta[axis] = absInvDir[axis];
        } else if (sgn_dir[axis] < 0.0) {
            tMax[axis] = cellOffset[axis] * absInvDir[axis];
            tDelta[axis] = absInvDir[axis];
        } else {
            tMax[axis] = FLT_MAX;
            tDelta[axis] = FLT_MAX;
        }
    }

    ivec3 istep = ivec3(round(sgn_dir));

    ivec3 texel_coord = ivec3(-1);
    uvec4 texel = uvec4(0u);
    bool occupied = readVoxel(coord, texel, texel_coord, gridIndex, dimsI);
    uint traversed = 0u;
    uint stepped_axis = uint(entryAxis);
    float localTravel = 0.0;

    if (!occupied) {
        while (true) {
            int axis;
            if (tMax.x < tMax.y) {
                axis = (tMax.x < tMax.z) ? 0 : 2;
            } else {
                axis = (tMax.y < tMax.z) ? 1 : 2;
            }

            localTravel = tMax[axis];
            tMax[axis] += tDelta[axis];
            coord[axis] += istep[axis];
            traversed++;
            stepped_axis = uint(axis);

            if (coord.x < 0 || coord.y < 0 || coord.z < 0 ||
                coord.x >= dimsI.x || coord.y >= dimsI.y || coord.z >= dimsI.z) {
                steps = 0;
                hitParam = FLT_MAX;
                return false;
            }

            if (readVoxel(coord, texel, texel_coord, gridIndex, dimsI)) {
                occupied = true;
                break;
            }
        }
    }

    if (!occupied) {
        steps = 0;
        hitParam = FLT_MAX;
        return false;
    }

    float t_inside = (traversed == 0u) ? 0.0 : localTravel;
    vec3 mask = vec3(0.0);
    mask[stepped_axis] = 1.0;
    vec3 localNormal = -mask * sgn_dir;
    hitParam = tmin + t_inside;
    steps = traversed + 1u;

    switch (pc.render_mode) {
        case COORD:
            color = vec3(coord) / max(vec3(dims) - 1.0, vec3(1.0));
            break;
        case NORMAL:
            {
                vec3 normalWorld = normalize(mat3(gridInfos[gridIndex].gridToWorld) * localNormal);
                color = normalWorld * 0.5 + vec3(0.5);
            }
            break;
        case UV:
            vec3 hit = origin + dir * t_inside;
            vec3 local_hit = hit - coord;
            vec2 uv;
            if (stepped_axis == 0) {
                uv = local_hit.yz;
            } else if (stepped_axis == 1) {
                uv = local_hit.xz;
            } else {
                uv = local_hit.xy;
            }
            color = vec3(uv, 0);
            break;
        case DEPTH:
            float depth = (tmin + t_inside) * length(dir);
            float maxDim = float(max(dims.x, max(dims.y, dims.z)));
            color = vec3(1 / (1 + depth / maxDim)) + vec3(0.3, 0.0, 0.7) / 256;
            break;
        case SHADE:
            // Shaded lighting + approximate ambient occlusion inspired by provided Rust snippet.
            // Assumptions:
            // - No per-voxel stored color yet, so treat voxel as white (1,1,1).
            // - Fixed directional light (can be moved to push constants later if needed).
            // - AO considers orthogonal neighbor occupancy around the stepped neighbor cell.
            // - Uses the traversed normal derived above (same as NORMAL case logic) and mixes with a simple depth term.
            {
                // Fetch local palette index for this voxel; convert to global via grid's paletteBase/Len.
                uint local_idx = imageLoad(voxelColorIndices[gridIndex], ivec3(coord)).r;
                uint base = gridInfos[gridIndex].paletteBase;
                uint plen = gridInfos[gridIndex].paletteLen;
                uint clamped = (plen == 0) ? 0 : min(local_idx, plen - 1);
                uint palette_idx = base + clamped;
                vec3 voxel_base_color = vec3(1.0);
                if (palette_idx < palette.length()) {
                    voxel_base_color = palette[palette_idx].rgb;
                }
                // Reconstruct surface normal (same as NORMAL case) and transform to world space for lighting.
                vec3 normalWorld = normalize(mat3(gridInfos[gridIndex].gridToWorld) * localNormal);
                // Light direction (pointing from surface towards light). Choose something slightly off-axis for contrast.
                vec3 light_dir = normalize(pc.lightDir.xyz);
                float ndotl = clamp(dot(normalWorld, light_dir), -1.0, 1.0);
                float diff = (ndotl + 1.0) * 0.5; // map [-1,1] to [0,1]

                // Approximate AO: sample neighbor voxels around the neighbor cell in directions perpendicular to the step direction.
                // Determine neighbor cell (nbr) one step forward along stepped axis inside the voxel grid if valid.
                ivec3 base_coord = coord;
                ivec3 nbr = coord;
                int stepSign[3] = int[3](0, 0, 0);
                stepSign[0] = (sgn_dir.x > 0.0) ? 1 : ((sgn_dir.x < 0.0) ? -1 : 0);
                stepSign[1] = (sgn_dir.y > 0.0) ? 1 : ((sgn_dir.y < 0.0) ? -1 : 0);
                stepSign[2] = (sgn_dir.z > 0.0) ? 1 : ((sgn_dir.z < 0.0) ? -1 : 0);
                if (stepped_axis == 0) nbr.x = clamp(nbr.x + stepSign[0], 0, dimsI.x - 1);
                if (stepped_axis == 1) nbr.y = clamp(nbr.y + stepSign[1], 0, dimsI.y - 1);
                if (stepped_axis == 2) nbr.z = clamp(nbr.z + stepSign[2], 0, dimsI.z - 1);

                // Direction vector dir = nbr - base in integer space:
                ivec3 idir = ivec3(nbr) - ivec3(base_coord);
                int dAxis = 0;
                if (abs(idir.y) > 0) dAxis = 1; else if (abs(idir.z) > 0) dAxis = 2;

                // Offsets to probe along perpendicular axes (like OFFS in Rust). Here choose {-1, +1}.
                int OFFS[2] = int[2](-1, 1);
                int occ = 0;
                int probes = 0;
                for (int ax = 0; ax < 3; ++ax) {
                    if (ax == dAxis) continue; // perpendicular only
                    for (int oi = 0; oi < 2; ++oi) {
                        ivec3 p = ivec3(nbr);
                        if (ax == 0) p.x += OFFS[oi];
                        if (ax == 1) p.y += OFFS[oi];
                        if (ax == 2) p.z += OFFS[oi];
                        // Bounds check
                        if (p.x < 0 || p.y < 0 || p.z < 0 || p.x >= int(dims.x) || p.y >= int(dims.y) || p.z >= int(dims.z))
                            continue;
                        // Read occupancy (reuse helper logic):
                        uvec4 texAO; ivec3 texAOcoord = ivec3(-1);
                        if (readVoxel(p, texAO, texAOcoord, gridIndex, dimsI)) {
                            occ++;
                        }
                        probes++;
                    }
                }
                float ao = 1.0 - float(occ) * 0.2; // matches multiplier pattern in Rust snippet
                ao = clamp(ao, 0.0, 1.0);
                float c = diff * ao;

                // Depth weighting: reuse same depth notion as DEPTH (approx distance from entry point)
                float depth = (tmin + t_inside) * length(dir);
                float maxDim = float(max(dims.x, max(dims.y, dims.z)));
                float depth_term = (1.0 / (1.0 + depth / maxDim));
                // Combine similar to rust: c = c*0.6 + spos[2]*0.4, approximate spos.z with normalized depth term.
                c = c * 0.6 + depth_term * 0.4;
                color = voxel_base_color * c;
            }
            break;
    }
    return true;
}

void renderSteps(ivec2 pixelCoord, uint steps, uint maxDim) {
    vec3 color = stepsToInferno(steps, 0, max(1u, (maxDim - 1)) * 3);
    imageStore(targetImage, pixelCoord, vec4(color, 1));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(targetImage);

    if (any(greaterThanEqual(pixelCoord, imageSize)))
        return;

    vec3 ro = pc.pixelToRay[3].xyz;
    vec3 rd = mat3(pc.pixelToRay) * vec3(pixelCoord, 1);
    float rdLen = length(rd);
    vec3 rdNorm = (rdLen > 0.0) ? rd / rdLen : vec3(0.0);

    uint gridCount = pc.voxel_count;
    // Precompute per-grid local ray representations using the provided transforms.
    vec3 localOrigins[MAX_GRIDS];
    vec3 localDirections[MAX_GRIDS];
    for (uint g = 0; g < gridCount; ++g) {
        mat4 gridToWorld = gridInfos[g].gridToWorld;
        mat4 worldToGrid = inverse(gridToWorld);
        localOrigins[g] = (worldToGrid * vec4(ro, 1.0)).xyz;
        localDirections[g] = (worldToGrid * vec4(rd, 0.0)).xyz;
    }

    // MAX_GRIDS defined above
    float tEnter[MAX_GRIDS];
    float tExit[MAX_GRIDS];
    int gridOrder[MAX_GRIDS];
    for (int i = 0; i < MAX_GRIDS; ++i) { tEnter[i] = FLT_MAX; tExit[i] = -1.0; gridOrder[i] = i; }
    for (uint g = 0; g < gridCount; g++) {
        uvec3 dims = uvec3(gridInfos[g].dimX, gridInfos[g].dimY, gridInfos[g].dimZ);
        vec3 inv_dir = 1. / localDirections[g];
        vec3 t0 = (vec3(0.0) - localOrigins[g]) * inv_dir;
        vec3 t1 = (vec3(dims) - localOrigins[g]) * inv_dir;
        vec3 tsm = min(t0, t1);
        vec3 tbg = max(t0, t1);
        float tmin = max(0.0, max(tsm.x, max(tsm.y, tsm.z)));
        float tmax = min(tbg.x, min(tbg.y, tbg.z));
        if (tmin <= tmax) { // intersects
            tEnter[g] = tmin;
            tExit[g] = tmax;
        } else {
            tEnter[g] = FLT_MAX;
            tExit[g] = -1.0;
        }
    }
    // Simple selection sort of up to gridCount elements by tEnter.
    for (int i = 0; i < int(gridCount); ++i) {
        gridOrder[i] = i;
    }
    for (int i = 0; i < int(gridCount); ++i) {
        for (int j = i + 1; j < int(gridCount); ++j) {
            int idxI = gridOrder[i];
            int idxJ = gridOrder[j];
            if (tEnter[idxJ] < tEnter[idxI]) {
                int tmp = gridOrder[i];
                gridOrder[i] = gridOrder[j];
                gridOrder[j] = tmp;
            }
        }
    }
    vec3 bestColor = vec3(0.0);
    float bestWorldParam = FLT_MAX;
    uint bestSteps = 0;
    uint cumulativeSteps = 0;
    uint bestSize = 0;
    uint lastVisitedSize = 1u;
    int bestGridIdx = -1;
    float bestDepthRatio = 0.0;

    for (int order = 0; order < int(gridCount); ++order) {
        int gridIdx = gridOrder[order];
        if (gridIdx < 0) continue;
        if (tEnter[gridIdx] == FLT_MAX) continue; // no intersection
        uvec3 dims = uvec3(gridInfos[gridIdx].dimX, gridInfos[gridIdx].dimY, gridInfos[gridIdx].dimZ);
        uint size = max(dims.x, max(dims.y, dims.z));
        lastVisitedSize = size;
        vec3 localOrigin = localOrigins[gridIdx];
        vec3 localDir = localDirections[gridIdx];
        vec3 gridColor;
        uint gridSteps = 0u;
        float gridHitParam = FLT_MAX;
        bool gridHit = traversal(gridIdx, localOrigin, localDir, dims, gridColor, gridSteps, gridHitParam);
        uint newCumulative = cumulativeSteps + gridSteps;
        cumulativeSteps = newCumulative;
        if (gridHit) {
            vec3 localHit = localOrigin + localDir * gridHitParam;
            vec3 worldHit = (gridInfos[gridIdx].gridToWorld * vec4(localHit, 1.0)).xyz;
            float worldParam = dot(worldHit - ro, rdNorm);
            if (worldParam >= -1e-4 && worldParam < bestWorldParam) {
                bestWorldParam = worldParam;
                bestColor = gridColor;
                bestSteps = newCumulative;
                bestSize = size;
                bestGridIdx = gridIdx;
                float denom = max(tExit[gridIdx] - tEnter[gridIdx], 1e-6);
                bestDepthRatio = clamp((gridHitParam - tEnter[gridIdx]) / denom, 0.0, 1.0);
                if (bestDepthRatio > 0.98) {
                    ivec3 finalCoord = ivec3(clamp(floor(localHit), vec3(0.0), vec3(vec3(dims) - 1.0)));
                    ivec3 texcoord = ivec3(-1);
                    uvec4 texsample = uvec4(0u);
                    if (!readVoxel(finalCoord, texsample, texcoord, gridIdx, ivec3(dims))) {
                        bestWorldParam = FLT_MAX;
                        bestGridIdx = -1;
                        bestSteps = cumulativeSteps;
                        bestColor = vec3(0.0);
                        continue;
                    }
                }
                continue;
            }
        }
    }
    if (bestWorldParam == FLT_MAX && gridCount > 0) {
        int groundIdx = int(gridCount) - 1;
        uvec3 dims = uvec3(gridInfos[groundIdx].dimX, gridInfos[groundIdx].dimY, gridInfos[groundIdx].dimZ);
        vec3 groundColor;
        uint groundSteps = 0u;
        float groundHitParam = FLT_MAX;
        bool groundHit = traversal(groundIdx, localOrigins[groundIdx], localDirections[groundIdx], dims, groundColor, groundSteps, groundHitParam);
        uint groundSize = max(dims.x, max(dims.y, dims.z));
        lastVisitedSize = groundSize;
        cumulativeSteps += groundSteps;
        if (groundHit) {
            vec3 localHit = localOrigins[groundIdx] + localDirections[groundIdx] * groundHitParam;
            vec3 worldHit = (gridInfos[groundIdx].gridToWorld * vec4(localHit, 1.0)).xyz;
            float worldParam = dot(worldHit - ro, rdNorm);
            if (worldParam >= -1e-4 && worldParam < bestWorldParam) {
                bestWorldParam = worldParam;
                bestColor = groundColor;
                bestSteps = cumulativeSteps;
                bestSize = groundSize;
                bestGridIdx = groundIdx;
                float denom = max(tExit[groundIdx] - tEnter[groundIdx], 1e-6);
                bestDepthRatio = clamp((groundHitParam - tEnter[groundIdx]) / denom, 0.0, 1.0);
            }
        }
    }
    if (bestWorldParam < FLT_MAX) {
#if DEBUG_WEDGE
        float idxNorm = (bestGridIdx >= 0) ? float(bestGridIdx) / float(max(int(gridCount), 1)) : 0.0;
    float distNorm = bestDepthRatio;
        float stepsNorm = clamp(float(bestSteps % 256u) / 255.0, 0.0, 1.0);
        vec3 debugColor = vec3(idxNorm, distNorm, stepsNorm);
        if (bestGridIdx >= 0) {
            ivec3 dimsDbg = ivec3(gridInfos[bestGridIdx].dimX, gridInfos[bestGridIdx].dimY, gridInfos[bestGridIdx].dimZ);
            ivec3 probe = clamp(ivec3(localOrigins[bestGridIdx]), ivec3(0), dimsDbg - ivec3(1));
            probe = max(probe, ivec3(0));
            uint idx = imageLoad(voxelColorIndices[bestGridIdx], probe).r;
            uint base = gridInfos[bestGridIdx].paletteBase;
            uint len = gridInfos[bestGridIdx].paletteLen;
            if (len > 0) {
                uint paletteIdx = base + min(idx, len - 1);
                if (paletteIdx < palette.length()) {
                    vec3 palColor = palette[paletteIdx].rgb;
                    const float BLEND = 0.02;
                    debugColor = mix(debugColor, palColor, BLEND);
                }
            }
        }
        imageStore(targetImage, pixelCoord, vec4(debugColor, 1));
#else
        if (pc.render_mode != STEPS) {
            imageStore(targetImage, pixelCoord, vec4(bestColor, 1));
        } else {
            renderSteps(pixelCoord, bestSteps, bestSize);
        }
#endif
    } else if (cumulativeSteps > 0 && pc.render_mode == STEPS && gridCount > 0) {
        renderSteps(pixelCoord, cumulativeSteps, lastVisitedSize);
    }
}
