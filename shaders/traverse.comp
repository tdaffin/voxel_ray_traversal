#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Render modes: MUST stay in sync with the Rust RenderMode enum (search for RenderMode in main.rs or related file)
const uint COORD = 0;
const uint STEPS = 1;
const uint NORMAL = 2;
const uint UV = 3;
const uint DEPTH = 4;
const uint SHADE = 5; // New: shaded lighting + simple AO (update host RenderMode enum accordingly)
const uint DEBUG = 6;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    mat4 pixelToRay;
    vec4 lightDir; // xyz = normalized light direction, w unused
    uint voxel_count;
    uint render_mode;
    uint always_instant;
} pc;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D targetImage;
// Runtime-sized array of voxel grids (descriptor array only)
// Fixed-size descriptor array to simplify host binding (avoid runtime descriptor array issues)
const int MAX_GRIDS = 32;
layout(set = 1, binding = 0, rgba32ui) readonly uniform uimage3D voxelImages[MAX_GRIDS];
// Per-voxel palette index (R8_UINT) stored in R component of each texel.
// Future enhancement: add a small palette buffer (e.g. SSBO of vec4) so index -> color lookup supports custom materials.
layout(set = 1, binding = 1, r8ui) readonly uniform uimage3D voxelColorIndices[MAX_GRIDS];
// Palette buffer: 256 RGBA colors (can be fewer; unused entries ignored)
layout(set = 1, binding = 2) readonly buffer PaletteBuffer {
    vec4 palette[]; // size announced by host; expected <= 256
};
// Per-grid metadata buffer (dynamic length = voxel_count)
struct GridInfo {
    uint resolution; // legacy (kept for backward compatibility; not used for addressing now)
    uint dimX;       // actual content dims (<= resolution)
    uint dimY;
    uint dimZ;
    uint storageW;   // packed texel width (currently resolution/4)
    uint storageH;   // packed texel height (currently resolution/4)
    uint storageD;   // packed texel depth (currently resolution/8)
    uint paletteBase; // starting index into palette buffer
    uint paletteLen;  // number of valid entries for this grid
    uint _padding0;   // pad to 16-byte alignment for subsequent matrix
    uint _padding1;
    uint _padding2;
    mat4 gridToWorld; // transforms voxel-local coordinates to world space
};
layout(set = 1, binding = 3) readonly buffer GridInfoBuffer { GridInfo gridInfos[]; };

// https://www.shadertoy.com/view/WlfXRN
vec3 inferno(float t) {
    const vec3 c0 = vec3(0.0002189403691192265, 0.001651004631001012, -0.01948089843709184);
    const vec3 c1 = vec3(0.1065134194856116, 0.5639564367884091, 3.932712388889277);
    const vec3 c2 = vec3(11.60249308247187, -3.972853965665698, -15.9423941062914);
    const vec3 c3 = vec3(-41.70399613139459, 17.43639888205313, 44.35414519872813);
    const vec3 c4 = vec3(77.162935699427, -33.40235894210092, -81.80730925738993);
    const vec3 c5 = vec3(-71.31942824499214, 32.62606426397723, 73.20951985803202);
    const vec3 c6 = vec3(25.13112622477341, -12.24266895238567, -23.07032500287172);

    return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
}

vec3 stepsToInferno(uint steps, uint start, uint end) {
    float t = float(int(steps - start)) / (end - start);
    return inferno(clamp(t, 0, 1));
}

// Reads occupancy of a voxel cell by reusing a cached packed texel when possible.
// Returns true if the voxel at `coord` is filled, updating `texel` and `texel_coord` if a new block is fetched.
bool readVoxel(uvec3 coord, inout uvec4 texel, inout ivec3 texel_coord, int gridIndex) {
    // Uses per-grid storage block dimensions (4x4x8 voxels per texel) independent of cubic "resolution".
    ivec3 new_texel_coord = ivec3(coord.x / 4, coord.y / 4, coord.z / 8);
    if (new_texel_coord != texel_coord) {
        texel_coord = new_texel_coord;
        texel = imageLoad(voxelImages[gridIndex], texel_coord);
    }
    return bool(texel[coord.x % 4] >> ((coord.y % 4) + (coord.z % 8) * 4) & 1u);
}

const float FLT_MAX = 3.4028235e+38;

// Aggregate of data describing a voxel ray hit that downstream shading needs.
struct HitAttributes {
    uvec3 coord;      // Integer coordinates of the voxel cell hit (in grid-local space).
    vec3 localNormal; // Surface normal in grid-local space pointing against the ray advance.
    vec3 localHit;    // Exact hit position in grid-local coordinates.
    uint steppedAxis; // Axis index (0/1/2) representing which axis was last stepped when entering the voxel.
    float tmin;       // Parametric distance from entry point into the grid to the start of traversal.
    float tInside;    // Parametric distance traveled inside the voxel to reach the hit position.
    vec3 sgnDir;      // Sign of the inverse ray direction used for stepping decisions per axis.
    uvec3 dims;       // Dimensions of the voxel grid (number of cells along each axis).
    vec3 localDir;    // Ray direction expressed in grid-local space.
    vec3 entryPoint;  // Grid-local position where the ray first entered the grid's bounds.
    int gridIndex;    // Index into `gridInfos` and associated buffers identifying the grid that was hit.
    float hitDistance; // World-space distance from ray origin to the hit point for this grid.
    uint stepsTaken;   // Number of voxel steps taken within this grid traversal.
    bool outOfBounds; // True if the traversal exited the grid bounds without hitting a voxel.
};

// Performs voxel traversal for a single grid, recording the first hit and gathering hit attributes.
// Returns true when a solid voxel is encountered, writing the distance traveled, steps taken, and `HitAttributes`.
bool traversal(int gridIndex, vec3 origin, vec3 dir, uvec3 dims, vec3 roWorld, vec3 rdNormWorld,
    out HitAttributes outHit)
{
    uint stepsLocal = 0u;
    outHit.coord = uvec3(0);
    outHit.localNormal = vec3(0);
    outHit.localHit = vec3(0);
    outHit.steppedAxis = 0u;
    outHit.tmin = 0.0;
    outHit.tInside = 0.0;
    outHit.sgnDir = vec3(0);
    outHit.dims = dims;
    outHit.localDir = dir;
    outHit.entryPoint = vec3(0);
    outHit.gridIndex = gridIndex;
    outHit.hitDistance = FLT_MAX;
    outHit.stepsTaken = 0u;
    outHit.outOfBounds = false;
    vec3 inv_dir = 1. / dir;
    vec3 sgn_dir = sign(inv_dir);
    inv_dir = clamp(inv_dir, vec3(-FLT_MAX), vec3(FLT_MAX));

    vec3 t1 = -origin * inv_dir;
    vec3 t2 = (vec3(dims) - origin) * inv_dir;

    vec3 tmins = min(t1, t2);
    vec3 tmaxs = max(t1, t2);

    float tmin = 0;
    float tmax = FLT_MAX;
    for (int i = 0; i < 3; i++) {
        tmin = max(tmin, tmins[i]);
        tmax = min(tmax, tmaxs[i]);
    }

    if (tmin > tmax) {
        outHit.stepsTaken = stepsLocal;
        outHit.hitDistance = FLT_MAX;
        return false;
    }

    uint stepped_axis = 0u;
    float stepped_t = tmins.x;
    if (tmins.y > stepped_t) {
        stepped_axis = 1u;
        stepped_t = tmins.y;
    }
    if (tmins.z > stepped_t) {
        stepped_axis = 2u;
        stepped_t = tmins.z;
    }

    origin += dir * tmin;
    outHit.entryPoint = origin;
    uvec3 coord = uvec3(clamp(floor(origin), vec3(0), vec3(vec3(dims) - 1.0)));
    vec3 t = (coord + 0.5 * (1 + sgn_dir) - origin) * inv_dir;

    uvec3 ustep = uvec3(ivec3(sgn_dir));
    vec3 delta = inv_dir * sgn_dir;

    ivec3 texel_coord = ivec3(coord.x / 4, coord.y / 4, coord.z / 8);
    uvec4 texel = imageLoad(voxelImages[gridIndex], texel_coord);
    bool initialOccupied = bool(texel[coord.x % 4] >> ((coord.y % 4) + (coord.z % 8) * 4) & 1u);
    bool hit = (pc.always_instant != 0u) || initialOccupied;
    while (!hit) {
        stepsLocal++;
#ifndef BRANCHLESS_TRAVERSAL
        if (t.x < t.y) {
            if (t.x < t.z) {
                coord.x += ustep.x;
                t.x += delta.x;
                stepped_axis = 0;
            } else {
                coord.z += ustep.z;
                t.z += delta.z;
                stepped_axis = 2;
            }
        } else {
            if (t.y < t.z) {
                coord.y += ustep.y;
                t.y += delta.y;
                stepped_axis = 1;
            } else {
                coord.z += ustep.z;
                t.z += delta.z;
                stepped_axis = 2;
            }
        }
#else
        // Branchless variant: compute mask selecting axis to advance.
        uvec3 mask = uvec3(
            (t.x < t.y && t.x < t.z) ? 1u : 0u,
            (t.x >= t.y && t.y < t.z) ? 1u : 0u,
            (t.x >= t.z && t.y >= t.z) ? 1u : 0u
        );
        coord += ustep * mask;
        t += delta * mask;
        stepped_axis = (mask.x != 0u) ? 0u : ((mask.y != 0u) ? 1u : 2u);
#endif

        if (any(greaterThanEqual(coord, dims))) {
            outHit.outOfBounds = true;
            hit = true;
            break;
        }
        if (readVoxel(coord, texel, texel_coord, gridIndex))
            hit = true;
    }

    vec3 mask = vec3(0);
    mask[stepped_axis] = 1;
    float t_inside = dot(t, mask) - dot(delta, mask);
    vec3 localNormal = -mask * sgn_dir;
    vec3 localHit = origin + dir * t_inside;
    vec3 hitWorld = (gridInfos[gridIndex].gridToWorld * vec4(localHit, 1.0)).xyz;
    outHit.hitDistance = length(hitWorld - roWorld);
    outHit.stepsTaken = stepsLocal;
    outHit.coord = coord;
    outHit.localNormal = localNormal;
    outHit.localHit = localHit;
    outHit.steppedAxis = stepped_axis;
    outHit.tmin = tmin;
    outHit.tInside = t_inside;
    outHit.sgnDir = sgn_dir;
    return hit;
}

// Converts the gathered hit attributes into an RGB color according to the current render mode.
vec3 calc_color(HitAttributes hit)
{
    switch (pc.render_mode) {
        case COORD:
            return vec3(hit.coord) / max(vec3(hit.dims) - 1.0, vec3(1.0));
        case NORMAL:
            {
                vec3 normalWorld = normalize(mat3(gridInfos[hit.gridIndex].gridToWorld) * hit.localNormal);
                return normalWorld * 0.5 + vec3(0.5);
            }
        case UV:
            {
                vec3 local_hit = hit.localHit - vec3(hit.coord);
                vec2 uv;
                if (hit.steppedAxis == 0u) {
                    uv = local_hit.yz;
                } else if (hit.steppedAxis == 1u) {
                    uv = local_hit.xz;
                } else {
                    uv = local_hit.xy;
                }
                return vec3(uv, 0);
            }
        case DEPTH:
            {
                vec3 entry = hit.entryPoint;
                //vec3 dir = hit.localDir;
                float hitDist = length(hit.localHit - entry);
                float maxDim = float(max(hit.dims.x, max(hit.dims.y, hit.dims.z)));
                //float depthNorm = hitDist / maxDim;
                float depthNorm = (maxDim > 0.0) ? clamp(hitDist / maxDim, 0.0, 1.0) : 0.0;
                //float depthNorm = (maxDist > 0.0) ? clamp(hitDist / maxDist, 0.0, 1.0) : 0.0;
                vec3 nearColor = vec3(0.1, 0.0, 0.5);
                vec3 farColor = vec3(1.0);
                return mix(nearColor, farColor, depthNorm);
                //float depth = (hit.tmin + hit.tInside) * length(hit.localDir);
                //return vec3(1.0 / (1.0 + depth / maxDim)) + vec3(0.3, 0.0, 0.7) / 256.0;
            }
        case SHADE:
            {
                uint local_idx = imageLoad(voxelColorIndices[hit.gridIndex], ivec3(hit.coord)).r;
                uint base = gridInfos[hit.gridIndex].paletteBase;
                uint plen = gridInfos[hit.gridIndex].paletteLen;
                uint clamped = (plen == 0u) ? 0u : min(local_idx, plen - 1u);
                uint palette_idx = base + clamped;
                vec3 voxel_base_color = vec3(1.0);
                if (palette_idx < palette.length()) {
                    voxel_base_color = palette[palette_idx].rgb;
                }
                vec3 normalWorld = normalize(mat3(gridInfos[hit.gridIndex].gridToWorld) * hit.localNormal);
                vec3 light_dir = normalize(pc.lightDir.xyz);
                float ndotl = clamp(dot(normalWorld, light_dir), -1.0, 1.0);
                float diff = (ndotl + 1.0) * 0.5;

                uvec3 base_coord = hit.coord;
                uvec3 nbr = hit.coord;
                if (hit.steppedAxis == 0u) nbr.x = min(nbr.x + (uint(hit.sgnDir.x > 0.0)), hit.dims.x - 1u);
                if (hit.steppedAxis == 1u) nbr.y = min(nbr.y + (uint(hit.sgnDir.y > 0.0)), hit.dims.y - 1u);
                if (hit.steppedAxis == 2u) nbr.z = min(nbr.z + (uint(hit.sgnDir.z > 0.0)), hit.dims.z - 1u);

                ivec3 idir = ivec3(nbr) - ivec3(base_coord);
                int dAxis = 0;
                if (abs(idir.y) > 0) dAxis = 1; else if (abs(idir.z) > 0) dAxis = 2;

                int OFFS[2] = int[2](-1, 1);
                int occ = 0;
                int probes = 0;
                for (int ax = 0; ax < 3; ++ax) {
                    if (ax == dAxis) continue;
                    for (int oi = 0; oi < 2; ++oi) {
                        ivec3 p = ivec3(nbr);
                        if (ax == 0) p.x += OFFS[oi];
                        if (ax == 1) p.y += OFFS[oi];
                        if (ax == 2) p.z += OFFS[oi];
                        if (p.x < 0 || p.y < 0 || p.z < 0 || p.x >= int(hit.dims.x) || p.y >= int(hit.dims.y) || p.z >= int(hit.dims.z))
                            continue;
                        uvec3 q = uvec3(p);
                        uvec4 texAO;
                        ivec3 texAOcoord = ivec3(-1);
                        if (readVoxel(q, texAO, texAOcoord, hit.gridIndex)) {
                            occ++;
                        }
                        probes++;
                    }
                }
                float ao = 1.0 - float(occ) * 0.2;
                ao = clamp(ao, 0.0, 1.0);
                float c = diff * ao;
                c = diff;

                // Depth weighting: reuse same depth notion as DEPTH (approx distance from entry point)
                /*float depth = (hit.tmin + hit.tInside) * length(hit.localDir);
                float maxDim = float(max(hit.dims.x, max(hit.dims.y, hit.dims.z)));
                float depth_term = (1.0 / (1.0 + depth / maxDim));
                // Combine similar to rust: c = c*0.6 + spos[2]*0.4, approximate spos.z with normalized depth term.
                c = c * 0.6 + depth_term * 0.4;*/
                return voxel_base_color * c;
            }
    }
    return vec3(0.0);
}

// Visualizes the traversal step count using the inferno colormap, normalized by max grid dimension.
void renderSteps(ivec2 pixelCoord, uint steps, uint maxDim) {
    vec3 color = stepsToInferno(steps, 0, max(1u, (maxDim - 1)) * 3);
    imageStore(targetImage, pixelCoord, vec4(color, 1));
}

const uint debugX = 180;
const uint debugY = 86;
const ivec2 debugCoord = ivec2(debugX, debugY);

// Entry point for the compute shader: casts a ray per pixel, finds the nearest voxel hit, and shades it.
void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(targetImage);

    if (any(greaterThanEqual(pixelCoord, imageSize)))
        return;

    vec3 ro = pc.pixelToRay[3].xyz;
    vec3 rd = mat3(pc.pixelToRay) * vec3(pixelCoord, 1);
    vec3 rdNorm = normalize(rd);

    uint gridCount = pc.voxel_count;
    // Precompute per-grid local ray representations using the provided transforms.
    vec3 localOrigins[MAX_GRIDS];
    vec3 localDirections[MAX_GRIDS];
    for (uint g = 0; g < gridCount; ++g) {
        mat4 gridToWorld = gridInfos[g].gridToWorld;
        mat4 worldToGrid = inverse(gridToWorld);
        localOrigins[g] = (worldToGrid * vec4(ro, 1.0)).xyz;
        localDirections[g] = (worldToGrid * vec4(rd, 0.0)).xyz;
    }

    // MAX_GRIDS defined above
    float tEnter[MAX_GRIDS];
    float tExit[MAX_GRIDS];
    int gridOrder[MAX_GRIDS];
    for (int i = 0; i < MAX_GRIDS; ++i) {
        tEnter[i] = FLT_MAX;
        tExit[i] = -1.0;
        gridOrder[i] = i;
    }
    for (uint g = 0; g < gridCount; g++) {
        uvec3 dims = uvec3(gridInfos[g].dimX, gridInfos[g].dimY, gridInfos[g].dimZ);
        vec3 inv_dir = 1. / localDirections[g];
        vec3 t0 = (vec3(0.0) - localOrigins[g]) * inv_dir;
        vec3 t1 = (vec3(dims) - localOrigins[g]) * inv_dir;
        vec3 tsm = min(t0, t1);
        vec3 tbg = max(t0, t1);
        float tmin = max(0.0, max(tsm.x, max(tsm.y, tsm.z)));
        float tmax = min(tbg.x, min(tbg.y, tbg.z));
        if (tmin <= tmax) { // intersects
            tEnter[g] = tmin;
            tExit[g] = tmax;
        } else {
            tEnter[g] = FLT_MAX;
            tExit[g] = -1.0;
        }
    }
    // Simple selection sort of up to gridCount elements by tEnter.
    for (int i = 0; i < int(gridCount); ++i) {
        gridOrder[i] = i;
    }
    for (int i = 0; i < int(gridCount); ++i) {
        for (int j = i + 1; j < int(gridCount); ++j) {
            int idxI = gridOrder[i];
            int idxJ = gridOrder[j];
            if (tEnter[idxJ] < tEnter[idxI]) {
                int tmp = gridOrder[i];
                gridOrder[i] = gridOrder[j];
                gridOrder[j] = tmp;
            }
        }
    }
    float bestDistance = FLT_MAX;
    uint totalSteps = 0u;
    uint stepsToBest = 0u;
    uint bestSize = 0u;
    uint largest_size = 0u;
    bool hitFound = false;
    HitAttributes bestHit;
    bestHit.coord = uvec3(0);
    bestHit.localNormal = vec3(0.0);
    bestHit.localHit = vec3(0.0);
    bestHit.steppedAxis = 0u;
    bestHit.tmin = 0.0;
    bestHit.tInside = 0.0;
    bestHit.sgnDir = vec3(0.0);
    bestHit.dims = uvec3(0);
    bestHit.localDir = vec3(0.0);
    bestHit.entryPoint = vec3(0.0);
    bestHit.gridIndex = -1;
    for (int order = 0; order < int(gridCount); ++order) {
        int gridIdx = gridOrder[order];
        if (gridIdx < 0)
            continue;
        if (tEnter[gridIdx] == FLT_MAX)
            continue; // no intersection
        uvec3 dims = uvec3(gridInfos[gridIdx].dimX, gridInfos[gridIdx].dimY, gridInfos[gridIdx].dimZ);
        uint size = max(dims.x, max(dims.y, dims.z));
        largest_size = max(largest_size, size);
        vec3 localOrigin = localOrigins[gridIdx];
        vec3 localDir = localDirections[gridIdx];
        HitAttributes hitAttr;
        bool hitThisGrid = traversal(gridIdx, localOrigin, localDir, dims, ro, rdNorm, hitAttr);
        if (hitThisGrid && hitAttr.hitDistance < bestDistance) {
            bestDistance = hitAttr.hitDistance;
            bestSize = size;
            stepsToBest = totalSteps + hitAttr.stepsTaken;
            hitFound = true;
            bestHit = hitAttr;
        }
        /*if (hitAttr.outOfBounds) {
            // Stop checking further grids if the ray has exited the current grid without a hit.
            break;
        }*/
        totalSteps += hitAttr.stepsTaken;
    }
    if (pc.render_mode == STEPS) {
        if (hitFound) {
            renderSteps(pixelCoord, stepsToBest, bestSize);
        } else if (totalSteps > 0u && gridCount > 0u) {
            // If no hit, visualize steps vs largest grid size
            renderSteps(pixelCoord, totalSteps, largest_size);
        }
    } else if (hitFound) {
        vec3 color = calc_color(bestHit);
        imageStore(targetImage, pixelCoord, vec4(color, 1));
    }
    //if (pixelCoord == debugCoord) { 
    if (pc.render_mode == DEBUG) {
        if (hitFound){
            vec4 color = vec4(1, bestHit.gridIndex / float(gridCount), 1, 1);
            imageStore(targetImage, pixelCoord, color);
        }
        //vec4 color = vec4(1, 0, 1, 1)
    }
}
