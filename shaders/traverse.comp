#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Render modes: MUST stay in sync with the Rust RenderMode enum (search for RenderMode in main.rs or related file)
const uint COORD = 0;
const uint STEPS = 1;
const uint NORMAL = 2;
const uint UV = 3;
const uint DEPTH = 4;
const uint SHADE = 5; // New: shaded lighting + simple AO (update host RenderMode enum accordingly)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    mat4 pixelToRay;
    uint voxel_count;
    uint render_mode;
    uvec2 _pad; // alignment padding
    uvec3 resolutions; // per-grid resolutions (only first voxel_count used)
} pc;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D targetImage;
// Runtime-sized array of voxel grids (descriptor array only)
// Fixed-size descriptor array to simplify host binding (avoid runtime descriptor array issues)
const int MAX_GRIDS = 32;
layout(set = 1, binding = 0, rgba32ui) readonly uniform uimage3D voxelImages[MAX_GRIDS];

// https://www.shadertoy.com/view/WlfXRN
vec3 inferno(float t) {
    const vec3 c0 = vec3(0.0002189403691192265, 0.001651004631001012, -0.01948089843709184);
    const vec3 c1 = vec3(0.1065134194856116, 0.5639564367884091, 3.932712388889277);
    const vec3 c2 = vec3(11.60249308247187, -3.972853965665698, -15.9423941062914);
    const vec3 c3 = vec3(-41.70399613139459, 17.43639888205313, 44.35414519872813);
    const vec3 c4 = vec3(77.162935699427, -33.40235894210092, -81.80730925738993);
    const vec3 c5 = vec3(-71.31942824499214, 32.62606426397723, 73.20951985803202);
    const vec3 c6 = vec3(25.13112622477341, -12.24266895238567, -23.07032500287172);

    return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
}

vec3 stepsToInferno(uint steps, uint start, uint end) {
    float t = float(int(steps - start)) / (end - start);
    return inferno(clamp(t, 0, 1));
}

bool readVoxel(uvec3 coord, inout uvec4 texel, inout ivec3 texel_coord, int gridIndex) {
    // Designed to match src\voxelize.rs:voxelize_mesh()
    ivec3 new_texel_coord = ivec3(coord.x / 4, coord.y / 4, coord.z / 8);
    if (new_texel_coord != texel_coord) {
        texel_coord = new_texel_coord;
        texel = imageLoad(voxelImages[gridIndex], texel_coord);
    }
    return bool(texel[coord.x % 4] >> ((coord.y % 4) + (coord.z % 8) * 4) & 1u);
}

const float FLT_MAX = 3.4028235e+38;

bool traversal(int gridIndex, vec3 origin, vec3 dir, uint voxel_resolution, out vec3 color, inout uint steps) {
    vec3 inv_dir = 1. / dir;
    vec3 sgn_dir = sign(inv_dir);
    inv_dir = clamp(inv_dir, vec3(-FLT_MAX), vec3(FLT_MAX));

    vec3 t1 = -origin * inv_dir;
    vec3 t2 = (vec3(voxel_resolution) - origin) * inv_dir;

    vec3 tmins = min(t1, t2);
    vec3 tmaxs = max(t1, t2);

    float tmin = 0;
    float tmax = FLT_MAX;
    for (int i = 0; i < 3; i++) {
        tmin = max(tmin, tmins[i]);
        tmax = min(tmax, tmaxs[i]);
    }

    if (tmin > tmax) {
        return false;
    }

    uint stepped_axis;
    if (tmins.x < tmins.y) {
        if (tmins.x < tmins.z) {
            stepped_axis = 0;
        } else {
            stepped_axis = 2;
        }
    } else {
        if (tmins.y < tmins.z) {
            stepped_axis = 1;
        } else {
            stepped_axis = 2;
        }
    }

    origin += dir * tmin;
    uvec3 coord = uvec3(clamp(floor(origin), vec3(0), vec3(voxel_resolution - 1)));
    vec3 t = (coord + 0.5 * (1 + sgn_dir) - origin) * inv_dir;

    uvec3 ustep = uvec3(ivec3(sgn_dir));
    vec3 delta = inv_dir * sgn_dir;

    ivec3 texel_coord = ivec3(coord.x / 4, coord.y / 4, coord.z / 8);
    uvec4 texel = imageLoad(voxelImages[gridIndex], texel_coord);
    bool instantHit = bool(texel[coord.x % 4] >> ((coord.y % 4) + (coord.z % 8) * 4) & 1u);
    if (!instantHit)
    while (true) {
        steps++;
        #ifndef BRANCHLESS_TRAVERSAL
            if (t.x < t.y) {
                if (t.x < t.z) {
                    coord.x += ustep.x;
                    t.x += delta.x;
                    stepped_axis = 0;
                } else {
                    coord.z += ustep.z;
                    t.z += delta.z;
                    stepped_axis = 2;
                }
            } else {
                if (t.y < t.z) {
                    coord.y += ustep.y;
                    t.y += delta.y;
                    stepped_axis = 1;
                } else {
                    coord.z += ustep.z;
                    t.z += delta.z;
                    stepped_axis = 2;
                }
            }
        #else
            // Branchless variant: compute mask selecting axis to advance.
            uvec3 mask = uvec3(
                (t.x < t.y && t.x < t.z) ? 1u : 0u,
                (t.x >= t.y && t.y < t.z) ? 1u : 0u,
                (t.x >= t.z && t.y >= t.z) ? 1u : 0u
            );
            coord += ustep * mask;
            t += delta * mask;
            stepped_axis = (mask.x != 0u) ? 0u : ((mask.y != 0u) ? 1u : 2u);
        #endif

        if (any(greaterThanEqual(coord, uvec3(voxel_resolution))))
        return false;
        if (readVoxel(coord, texel, texel_coord, gridIndex))
        break;
    }

    vec3 mask = vec3(0);
    mask[stepped_axis] = 1;
    float t_inside = dot(t, mask) - dot(delta, mask);

    switch (pc.render_mode) {
        case COORD:
            color = vec3(coord) / vec3(voxel_resolution - 1);
            break;
        case NORMAL:
            vec3 normal = -mask * sgn_dir;
            color = max(normal.xyz, 0) - min(normal.yxz + normal.zyx, 0);
            break;
        case UV:
            vec3 hit = origin + dir * t_inside;
            vec3 local_hit = hit - coord;
            vec2 uv;
            if (stepped_axis == 0) {
                uv = local_hit.yz;
            } else if (stepped_axis == 1) {
                uv = local_hit.xz;
            } else {
                uv = local_hit.xy;
            }
            color = vec3(uv, 0);
            break;
        case DEPTH:
            float depth = (tmin + t_inside) * length(dir);
            color = vec3(1 / (1 + depth / voxel_resolution)) + vec3(0.3, 0.0, 0.7) / 256;
            break;
        case SHADE:
            // Shaded lighting + approximate ambient occlusion inspired by provided Rust snippet.
            // Assumptions:
            // - No per-voxel stored color yet, so treat voxel as white (1,1,1).
            // - Fixed directional light (can be moved to push constants later if needed).
            // - AO considers orthogonal neighbor occupancy around the stepped neighbor cell.
            // - Uses the traversed normal derived above (same as NORMAL case logic) and mixes with a simple depth term.
            {
                vec3 voxel_base_color = vec3(1.0); // placeholder for future voxel material/color
                // Reconstruct surface normal (same as NORMAL case):
                vec3 normal = -mask * sgn_dir;
                // Normalize (should already be unit length along axis, but keep for safety if logic changes):
                normal = normalize(normal);
                // Light direction (pointing from surface towards light). Choose something slightly off-axis for contrast.
                vec3 light_dir = normalize(vec3(0.5, 0.8, 0.3));
                float ndotl = clamp(dot(normal, light_dir), -1.0, 1.0);
                float diff = (ndotl + 1.0) * 0.5; // map [-1,1] to [0,1]

                // Approximate AO: sample neighbor voxels around the neighbor cell in directions perpendicular to the step direction.
                // Determine neighbor cell (nbr) one step forward along stepped axis inside the voxel grid if valid.
                uvec3 base_coord = coord; // impact voxel
                uvec3 nbr = coord;
                if (stepped_axis == 0) nbr.x = min(nbr.x + (uint(sgn_dir.x > 0.0)), voxel_resolution - 1);
                if (stepped_axis == 1) nbr.y = min(nbr.y + (uint(sgn_dir.y > 0.0)), voxel_resolution - 1);
                if (stepped_axis == 2) nbr.z = min(nbr.z + (uint(sgn_dir.z > 0.0)), voxel_resolution - 1);

                // Direction vector dir = nbr - base in integer space:
                ivec3 idir = ivec3(nbr) - ivec3(base_coord);
                int dAxis = 0;
                if (abs(idir.y) > 0) dAxis = 1; else if (abs(idir.z) > 0) dAxis = 2;

                // Offsets to probe along perpendicular axes (like OFFS in Rust). Here choose {-1, +1}.
                int OFFS[2] = int[2](-1, 1);
                int occ = 0;
                int probes = 0;
                for (int ax = 0; ax < 3; ++ax) {
                    if (ax == dAxis) continue; // perpendicular only
                    for (int oi = 0; oi < 2; ++oi) {
                        ivec3 p = ivec3(nbr);
                        if (ax == 0) p.x += OFFS[oi];
                        if (ax == 1) p.y += OFFS[oi];
                        if (ax == 2) p.z += OFFS[oi];
                        // Bounds check
                        if (p.x < 0 || p.y < 0 || p.z < 0 || p.x >= int(voxel_resolution) || p.y >= int(voxel_resolution) || p.z >= int(voxel_resolution))
                            continue;
                        // Read occupancy (reuse helper logic):
                        uvec3 q = uvec3(p);
                        // We need a fresh texel cache for arbitrary coords:
                        uvec4 texAO; ivec3 texAOcoord = ivec3(-1);
                        if (readVoxel(q, texAO, texAOcoord, gridIndex)) {
                            occ++;
                        }
                        probes++;
                    }
                }
                float ao = 1.0 - float(occ) * 0.2; // matches multiplier pattern in Rust snippet
                ao = clamp(ao, 0.0, 1.0);
                float c = diff * ao;

                // Depth weighting: reuse same depth notion as DEPTH (approx distance from entry point)
                float depth = (tmin + t_inside) * length(dir);
                float depth_term = (1.0 / (1.0 + depth / voxel_resolution));
                // Combine similar to rust: c = c*0.6 + spos[2]*0.4, approximate spos.z with normalized depth term.
                c = c * 0.6 + depth_term * 0.4;
                color = voxel_base_color * c;
            }
            break;
    }
    return true;
}

void renderSteps(ivec2 pixelCoord, uint steps, uint vr) {
    vec3 color = stepsToInferno(steps, 0, max(1u, (vr - 1)) * 3);
    imageStore(targetImage, pixelCoord, vec4(color, 1));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(targetImage);

    if (any(greaterThanEqual(pixelCoord, imageSize)))
        return;

    vec3 ro = pc.pixelToRay[3].xyz;
    vec3 rd = mat3(pc.pixelToRay) * vec3(pixelCoord, 1);

    uint gridCount = pc.voxel_count;
    // Precompute origins along X using each grid's own resolution plus 25% spacing of that grid size.
    float origins[MAX_GRIDS];
    float sizes[MAX_GRIDS];
    float cursor = 0.0;
    for (uint g = 0; g < gridCount; ++g) {
        uint res = pc.resolutions[g];
        float size = float(res);
        float spacing = size * 0.25;
        origins[g] = cursor;
        sizes[g] = size;
        cursor += size + spacing;
    }

    // MAX_GRIDS defined above
    float tEnter[MAX_GRIDS];
    float tExit[MAX_GRIDS];
    for (int i = 0; i < MAX_GRIDS; ++i) { tEnter[i] = FLT_MAX; tExit[i] = -1.0; }
    for (int g = 0; g < int(gridCount); g++) {
        vec3 origin = vec3(origins[g], 0, 0);
        vec3 bmin = origin;
        vec3 bmax = origin + vec3(sizes[g]);
        vec3 inv_dir = 1. / rd;
        vec3 t0 = (bmin - ro) * inv_dir;
        vec3 t1 = (bmax - ro) * inv_dir;
        vec3 tsm = min(t0, t1);
        vec3 tbg = max(t0, t1);
        float tmin = max(0.0, max(tsm.x, max(tsm.y, tsm.z)));
        float tmax = min(tbg.x, min(tbg.y, tbg.z));
        if (tmin <= tmax) { // intersects
            tEnter[g] = tmin;
            tExit[g] = tmax;
        } else {
            tEnter[g] = FLT_MAX;
            tExit[g] = -1.0;
        }
    }
    // Simple selection sort of up to gridCount elements by tEnter.
    for (int i = 0; i < int(gridCount); ++i) {
        for (int j = i + 1; j < int(gridCount); ++j) {
            if (tEnter[j] < tEnter[i]) {
                float te = tEnter[i]; tEnter[i] = tEnter[j]; tEnter[j] = te;
                float tx = tExit[i]; tExit[i] = tExit[j]; tExit[j] = tx;
                // swap grid indices by reusing tExit negative sentinel? Instead recompute index when traversing
            }
        }
    }
    // We lost which grid index each tEnter belonged to; recompute by matching tEnter.
    // Since there are only 3, brute force map when needed.
    vec3 color = vec3(0);
    uint steps = 0;
    bool hit = false;
    for (int order = 0; order < int(gridCount) && !hit; ++order) {
        if (tEnter[order] == FLT_MAX) continue; // no intersection
        // Find grid whose intersection start matches this tEnter (within epsilon).
        int gridIdx = -1;
        for (int g = 0; g < int(gridCount); g++) {
            vec3 origin = vec3(origins[g], 0, 0);
            vec3 bmin = origin;
            vec3 bmax = origin + vec3(sizes[g]);
            vec3 inv_dir = 1. / rd;
            vec3 t0 = (bmin - ro) * inv_dir;
            vec3 t1 = (bmax - ro) * inv_dir;
            vec3 tsm = min(t0, t1);
            vec3 tbg = max(t0, t1);
            float tmin = max(0.0, max(tsm.x, max(tsm.y, tsm.z)));
            float tmax = min(tbg.x, min(tbg.y, tbg.z));
            if (abs(tmin - tEnter[order]) < 1e-5 && abs(tmax - tExit[order]) < 1e-5) { gridIdx = g; break; }
        }
        if (gridIdx < 0) continue; // shouldn't happen
        uint vr = pc.resolutions[gridIdx];
        vec3 localOrigin = ro - vec3(origins[gridIdx], 0, 0);
        uint stepsBefore = steps;
        if (traversal(gridIdx, localOrigin, rd, vr, color, steps)) {
            hit = true;
            if (pc.render_mode != STEPS) {
                imageStore(targetImage, pixelCoord, vec4(color, 1));
            }
            if (pc.render_mode == STEPS)
                renderSteps(pixelCoord, steps, vr);
        } else {
            // traversal missed inside this grid volume; continue to next grid. steps already accumulated.
        }
    }
    // If no hit, optionally visualize steps vs first grid size (fallback)
    if (steps > 0 && pc.render_mode == STEPS && gridCount > 0)
        renderSteps(pixelCoord, steps, pc.resolutions[0]);
}
